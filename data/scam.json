{
 "missions": [
  {
   "id": "m01",
   "text": "قل كلمة «نقانيش» ثلاث مرات"
  },
  {
   "id": "m02",
   "text": "دخّل خمس كلمات إنجليزية في كلامك"
  },
  {
   "id": "m03",
   "text": "امدح لبس واحد من الشلة"
  },
  {
   "id": "m04",
   "text": "اسأل أحد: كم الساعة؟"
  },
  {
   "id": "m05",
   "text": "كرر آخر كلمة قالها اللي قبلك"
  },
  {
   "id": "m06",
   "text": "اضحك بصوت عالي مرتين بدون سبب"
  },
  {
   "id": "m07",
   "text": "قل «يا سلام» ثلاث مرات"
  },
  {
   "id": "m08",
   "text": "صفّق مرة وحدة بدون سبب"
  },
  {
   "id": "m09",
   "text": "اذكر اسم أكلة وأنت تتكلم عن شي ثاني"
  },
  {
   "id": "m10",
   "text": "نادِ واحد من الشلة باسم غلط"
  },
  {
   "id": "m11",
   "text": "قل «تذكرون؟» وكأنك تتذكر سالفة قديمة"
  },
  {
   "id": "m12",
   "text": "اسأل سؤال وجاوب عليه بنفسك"
  },
  {
   "id": "m13",
   "text": "قل «صح لسانك» لثلاثة أشخاص"
  },
  {
   "id": "m14",
   "text": "اعطس عطسة مزيفة"
  },
  {
   "id": "m15",
   "text": "قل رقم بدون مناسبة مرتين"
  },
  {
   "id": "m16",
   "text": "اذكر اسم دولة في كلامك ثلاث مرات"
  },
  {
   "id": "m17",
   "text": "قل «بالضبط!» أربع مرات"
  },
  {
   "id": "m18",
   "text": "قم من مكانك وارجع"
  },
  {
   "id": "m19",
   "text": "حط يدك على راسك مرتين"
  },
  {
   "id": "m20",
   "text": "قل كلمة «بطاطس» في جملة"
  },
  {
   "id": "m21",
   "text": "دندن لحن بصوت واطي"
  },
  {
   "id": "m22",
   "text": "قل «أنا النصاب» في أول الجولة كأنك تمزح"
  },
  {
   "id": "m23",
   "text": "اتهم واحد إنه النصاب بدون سبب"
  },
  {
   "id": "m24",
   "text": "دافع عن واحد بقوة وقل إنه أكيد مو النصاب"
  },
  {
   "id": "m25",
   "text": "ابدأ جملتين بـ«والحين…»"
  },
  {
   "id": "m26",
   "text": "تكلم بالفصحى في جملتين"
  },
  {
   "id": "m27",
   "text": "قلّد صوت واحد من الشلة مرة"
  },
  {
   "id": "m28",
   "text": "اسأل: «وش رايكم نطلب أكل؟»"
  },
  {
   "id": "m29",
   "text": "قل كلمة «فراولة» مرتين"
  },
  {
   "id": "m30",
   "text": "سلّم على أحد كأنك أول مرة تشوفه"
  },
  {
   "id": "m31",
   "text": "قل «يعطيك العافية» لثلاثة أشخاص"
  },
  {
   "id": "m32",
   "text": "اسأل أحد عن نوع جواله"
  },
  {
   "id": "m33",
   "text": "قل «اسمعوا اسمعوا» قبل ما تتكلم مرتين"
  },
  {
   "id": "m34",
   "text": "غيّر نبرة صوتك فجأة في جملة"
  },
  {
   "id": "m35",
   "text": "اذكر اسم حيوان ثلاث مرات"
  },
  {
   "id": "m36",
   "text": "قل «أكيد أكيد» مرتين"
  },
  {
   "id": "m37",
   "text": "اسأل: «مين اختار الكلمة هذي؟»"
  },
  {
   "id": "m38",
   "text": "قل «هذي سهلة!» بصوت عالي"
  },
  {
   "id": "m39",
   "text": "قل «ريّحوني» مرتين"
  },
  {
   "id": "m40",
   "text": "اذكر اسم لاعب كورة في كلامك"
  },
  {
   "id": "m41",
   "text": "اذكر اسم مدينة سعودية مرتين"
  },
  {
   "id": "m42",
   "text": "قل «وش قلت؟» لأحد مرتين"
  },
  {
   "id": "m43",
   "text": "قل «تراني فاهمها» بثقة"
  },
  {
   "id": "m44",
   "text": "ابدأ ثلاث جمل بـ«شوفوا»"
  },
  {
   "id": "m45",
   "text": "اسأل أحد: وش أكلت اليوم؟"
  },
  {
   "id": "m46",
   "text": "قل «هههه» بصوتك بدل ما تضحك"
  },
  {
   "id": "m47",
   "text": "سوّ علامة النصر بيدك مرتين"
  },
  {
   "id": "m48",
   "text": "قل «يمكن أنا النصاب» وأنت تضحك"
  },
  {
   "id": "m49",
   "text": "اقترح نغيّر قوانين اللعبة"
  },
  {
   "id": "m50",
   "text": "قل «لحظة لحظة» ثلاث مرات"
  },
  {
   "id": "m51",
   "text": "احسب على أصابعك بصوت عالي"
  },
  {
   "id": "m52",
   "text": "اذكر اسم لون ثلاث مرات"
  },
  {
   "id": "m53",
   "text": "اسأل: «كم باقي على التصويت؟»"
  },
  {
   "id": "m54",
   "text": "قل «أنا أعرف مين النصاب» بثقة"
  },
  {
   "id": "m55",
   "text": "امدح الكلمة: «كلمة حلوة الصراحة»"
  },
  {
   "id": "m56",
   "text": "قل «مستحيل!» مرتين"
  },
  {
   "id": "m57",
   "text": "اسأل أحد وش لونه المفضل"
  },
  {
   "id": "m58",
   "text": "قل «من جدك؟» لاثنين من الشلة"
  }
 ],
